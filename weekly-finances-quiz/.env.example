# Enter real keys locally in your environment. Never commit them.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Exact hostname returned by Turnstile, without a port.
TURNSTILE_EXPECTED_HOST=
# For a real deployment: PREVIEW_MODE=0, PUBLIC_ORIGIN=https://your-domain
PREVIEW_MODE=1
PUBLIC_ORIGIN=http://127.0.0.1:4317
PORT=4317
# Optional: only enable after the landing page privacy notice is approved.
METRICA_COUNTER_ID=
# Optional official App Store Connect campaign link; never fabricate provider IDs.
APP_STORE_CAMPAIGN_URL=
